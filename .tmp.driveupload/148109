{"version":3,"file":"PhotoGallery-BjfedWGy.js","sources":["../../src/Components/GalleryCard.jsx","../../src/PhotoGallery.jsx"],"sourcesContent":["import { useState, useContext, useEffect } from \"react\";\nimport { TweetContext } from \"../TweetContext\";\nimport \"./GalleryCard.css\";\n\nexport default function GalleryCard({ image, onOpenLightbox, onDelete, lightboxOpen }) {\n  const [flipped, setFlipped] = useState(false);\n\n  useEffect(() => {\n    if (!lightboxOpen) setFlipped(false);\n  }, [lightboxOpen]);\n  const { retweetRequest, openProfileSheet } = useContext(TweetContext);\n\n  const hasUser = !!image.username;\n\n  function handleFrontClick() {\n    setFlipped(true);\n  }\n\n  function handleBackClick(e) {\n    // Only flip back if the click landed on the back face itself, not a button\n    if (e.target === e.currentTarget) setFlipped(false);\n  }\n\n  function handleLoadFeed(e) {\n    e.stopPropagation();\n    retweetRequest(image.username);\n  }\n\n  function handleProfile(e) {\n    e.stopPropagation();\n    openProfileSheet(image.user_id, image.username, image.imageUrl);\n  }\n\n  function handleFullSize(e) {\n    e.stopPropagation();\n    onOpenLightbox();\n  }\n\n  function handleDelete(e) {\n    e.stopPropagation();\n    onDelete();\n  }\n\n  return (\n    <div className={`gc-scene${flipped ? \" gc-scene--flipped\" : \"\"}`}>\n      <div className=\"gc-card\">\n\n        {/* ── Front ── */}\n        <div className=\"gc-face gc-face--front\" onClick={handleFrontClick}>\n          <img src={image.imageUrl} alt=\"\" className=\"gc-face__img\" />\n          {hasUser && (\n            <div className=\"gc-face__label\">@{image.username}</div>\n          )}\n        </div>\n\n        {/* ── Back ── */}\n        <div className=\"gc-face gc-face--back\" onClick={handleBackClick}>\n          <img src={image.imageUrl} alt=\"\" className=\"gc-face__back-bg\" />\n          <div className=\"gc-face__back-veil\" />\n\n          <div className=\"gc-face__back-content\">\n            {hasUser && (\n              <span className=\"gc-back__username\">@{image.username}</span>\n            )}\n\n            <div className=\"gc-back__actions\">\n              <button className=\"gc-back__btn gc-back__btn--fullsize\" onClick={handleFullSize}>\n                <i className=\"fa-solid fa-expand\" />\n              </button>\n\n              {hasUser && (\n                <>\n                  <button className=\"gc-back__btn gc-back__btn--feed\" onClick={handleLoadFeed}>\n                    <i className=\"fa-solid fa-photo-film\" />\n                    <span>Feed</span>\n                  </button>\n                  {image.user_id && (\n                    <button className=\"gc-back__btn gc-back__btn--profile\" onClick={handleProfile}>\n                      <i className=\"fa-solid fa-users\" />\n                      <span>Profile</span>\n                    </button>\n                  )}\n                </>\n              )}\n\n              <button className=\"gc-back__btn gc-back__btn--delete\" onClick={handleDelete}>\n                <i className=\"fa-solid fa-trash-can\" />\n              </button>\n            </div>\n\n            <button className=\"gc-back__flip-back\" onClick={() => setFlipped(false)}>\n              <i className=\"fa-solid fa-rotate-left\" />\n            </button>\n          </div>\n        </div>\n\n      </div>\n    </div>\n  );\n}\n","import { useContext } from \"react\";\nimport \"./PhotoGallery.css\";\nimport { FirebaseContext } from \"./FirebaseContext\";\nimport { SkeletonGallery } from \"./Components/Skeleton\";\nimport EmptyState from \"./Components/EmptyState\";\nimport GalleryCard from \"./Components/GalleryCard\";\nimport UserProfileSheet from \"./Components/UserProfileSheet\";\n\nexport default function PhotoGallery() {\n  const {\n    sortedImages,\n    deleteImage,\n    selectedImage,\n    imageSelect,\n    closeImage,\n    isLoading,\n  } = useContext(FirebaseContext);\n\n  if (isLoading) {\n    return (\n      <div className=\"gallery-page\">\n        <h2 className=\"gallery-title\">Gallery</h2>\n        <SkeletonGallery count={12} />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"gallery-page\">\n      <h2 className=\"gallery-title\">Gallery</h2>\n\n      {sortedImages.length === 0 && (\n        <EmptyState\n          icon=\"fa-solid fa-photo-film\"\n          title=\"No photos saved yet\"\n          body=\"Tap the heart on any image in the feed to save it to your gallery.\"\n        />\n      )}\n\n      <div\n        style={selectedImage === undefined ? { filter: \"none\" } : { filter: \"blur(5px)\" }}\n        className=\"gallery\"\n      >\n        {sortedImages.map((image, index) => (\n          <GalleryCard\n            key={image?._id}\n            image={image}\n            onOpenLightbox={() => imageSelect(index)}\n            onDelete={() => deleteImage(image?.tweetId)}\n            lightboxOpen={selectedImage !== undefined}\n          />\n        ))}\n      </div>\n\n      {/* Lightbox */}\n      <div\n        style={selectedImage === undefined ? { display: \"none\" } : { display: \"flex\" }}\n        className=\"modal\"\n        onClick={closeImage}\n      >\n        <img\n          className=\"opened-image\"\n          src={sortedImages[selectedImage]?.imageUrl}\n          alt=\"\"\n        />\n      </div>\n\n      <UserProfileSheet />\n    </div>\n  );\n}\n"],"names":["GalleryCard","image","onOpenLightbox","onDelete","lightboxOpen","flipped","setFlipped","useState","useEffect","retweetRequest","openProfileSheet","useContext","TweetContext","hasUser","handleFrontClick","handleBackClick","e","handleLoadFeed","handleProfile","handleFullSize","handleDelete","jsx","jsxs","Fragment","PhotoGallery","sortedImages","deleteImage","selectedImage","imageSelect","closeImage","isLoading","FirebaseContext","SkeletonGallery","EmptyState","index","UserProfileSheet"],"mappings":"oKAIA,SAAwBA,EAAY,CAAE,MAAAC,EAAO,eAAAC,EAAgB,SA
# Copy this file to .env and fill in your values

# Venice AI (required for persona chat, story, scenarios, image edit)
VENICE_API_KEY=

# Hugging Face (required for ToriiGate chat)
HF_API_KEY=

# Firebase Admin SDK (required for Auth token verification + FCM notifications)
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Port (default: 4500)
PORT=4500
